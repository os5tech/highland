# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-generated-secret
KEYSTONE_ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgres://highland:highland@localhost:5432/highland_pm
DATABASE_SSL=false

# Microsoft Entra ID / Microsoft Graph
AUTH_MICROSOFT_ENTRA_ID_ID=00000000-0000-0000-0000-000000000000
AUTH_MICROSOFT_ENTRA_ID_SECRET=replace-in-secret-manager
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_WEBHOOK_SECRET=replace-in-secret-manager

# Bootstrap access until Entra group mappings are configured.
HIGHLAND_BOOTSTRAP_ADMIN_EMAILS=sergio@example.com

# Development-only auth bypass. Keep false in alpha/live unless a temporary
# IP allowlist has been deliberately approved.
KEYSTONE_DEV_AUTH_BYPASS=false
KEYSTONE_DEV_AUTH_ALLOWED_IPS=127.0.0.1,::1
KEYSTONE_DEV_AUTH_EMAIL=MSTestAdmin@highland-ca.com
KEYSTONE_DEV_AUTH_NAME=MSTest Admin

# Optional Entra group-to-role mappings.
ENTRA_GROUP_FIELD_EMPLOYEE_ID=
ENTRA_GROUP_PROJECT_MANAGER_ID=
ENTRA_GROUP_PROJECT_EXECUTIVE_ID=
ENTRA_GROUP_PAYROLL_ADMIN_ID=
ENTRA_GROUP_ACCOUNTING_ID=
ENTRA_GROUP_CFO_ID=
ENTRA_GROUP_OS5_ADMIN_ID=

# Future integration secrets. Keep real values in Google Secret Manager.
ADP_CLIENT_SECRET=
QUICKBOOKS_CLIENT_SECRET=
PROCORE_CLIENT_SECRET=
TWILIO_AUTH_TOKEN=
OPENAI_API_KEY=
